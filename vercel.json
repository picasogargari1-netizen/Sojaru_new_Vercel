{
  "services": {
    "web": {
      "root": "frontend",
      "framework": "create-react-app"
    },
    "api": {
      "root": "backend",
      "entrypoint": "server:app",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
